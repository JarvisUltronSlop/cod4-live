#include <windows.h>

1 VERSIONINFO
 FILEVERSION @COD4LIVE_VERSION_COMMAS@
 PRODUCTVERSION @COD4LIVE_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "cod4-live contributors\0"
   VALUE "FileDescription", "@COD4LIVE_FILE_DESCRIPTION@\0"
   VALUE "FileVersion", "@COD4LIVE_VERSION@\0"
   VALUE "InternalName", "@COD4LIVE_ORIGINAL_FILENAME@\0"
   VALUE "OriginalFilename", "@COD4LIVE_ORIGINAL_FILENAME@\0"
   VALUE "ProductName", "cod4-live\0"
   VALUE "ProductVersion", "@COD4LIVE_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
